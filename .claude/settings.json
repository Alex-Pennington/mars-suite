{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.prod*)",
      "Read(./.env.dev*)",
      "Read(./.env.staging)",
      "Read(./.env.test)",
      "Read(./.env.server)",
      "Read(./.env.secret*)",
      "Read(./.env.bak*)",
      "Read(./.env.pre*)",
      "Read(**/*.key)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  }
}
